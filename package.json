{
  "name": "@kannan19302/ui",
  "version": "1.0.15",
  "description": "UniERP Design System — one package, subpath exports (PLATFORM_ARCHITECTURE.md § 7.2)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles": "./dist/styles/globals.css",
    "./tokens/design-tokens.css": "./dist/tokens/design-tokens.css",
    "./tokens/base.css": "./dist/tokens/base.css",
    "./tokens/charts.css": "./dist/tokens/charts.css",
    "./tokens/index.css": "./dist/tokens/index.css",
    "./tokens/studio.css": "./dist/tokens/studio.css",
    "./tokens/themes/*": "./dist/tokens/themes/*",
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js",
      "require": "./dist/tokens/index.js",
      "default": "./dist/tokens/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js",
      "require": "./dist/theme/index.js",
      "default": "./dist/theme/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js",
      "require": "./dist/layout/index.js",
      "default": "./dist/layout/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts/index.js",
      "require": "./dist/charts/index.js",
      "default": "./dist/charts/index.js"
    },
    "./data-grid": {
      "types": "./dist/data-grid/index.d.ts",
      "import": "./dist/data-grid/index.js",
      "require": "./dist/data-grid/index.js",
      "default": "./dist/data-grid/index.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard/index.d.ts",
      "import": "./dist/dashboard/index.js",
      "require": "./dist/dashboard/index.js",
      "default": "./dist/dashboard/index.js"
    },
    "./notifications": {
      "types": "./dist/notifications/index.d.ts",
      "import": "./dist/notifications/index.js",
      "require": "./dist/notifications/index.js",
      "default": "./dist/notifications/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "require": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js",
      "require": "./dist/icons/index.js",
      "default": "./dist/icons/index.js"
    },
    "./form-engine": {
      "types": "./dist/form-engine/index.d.ts",
      "import": "./dist/form-engine/index.js",
      "require": "./dist/form-engine/index.js",
      "default": "./dist/form-engine/index.js"
    },
    "./workflow": {
      "types": "./dist/workflow/index.d.ts",
      "import": "./dist/workflow/index.js",
      "require": "./dist/workflow/index.js",
      "default": "./dist/workflow/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "import": "./dist/shell/index.js",
      "require": "./dist/shell/index.js",
      "default": "./dist/shell/index.js"
    },
    "./studio": {
      "types": "./dist/studio/index.d.ts",
      "import": "./dist/studio/index.js",
      "require": "./dist/studio/index.js",
      "default": "./dist/studio/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/check-contrast.mjs && node scripts/check-tokens.mjs && node scripts/generate-cross-platform-tokens.mjs --check && rimraf dist && tsc -p tsconfig.build.json && node scripts/copy-css.mjs && node scripts/fix-client-directives.mjs && node scripts/bundle-css-modules.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:tokens:baseline": "node scripts/check-tokens.mjs --baseline",
    "lint": "eslint src/",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "tokens:mobile": "node scripts/generate-cross-platform-tokens.mjs",
    "check:mobile-tokens": "node scripts/generate-cross-platform-tokens.mjs --check"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.0",
    "lucide-react": "^0.460.0",
    "recharts": "^3.9.0"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@kannan19302/config": "^1.0.2",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "2.1.9",
    "jsdom": "^25.0.0",
    "next": "^16.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "vitest-axe": "^0.1.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md"
  ]
}
